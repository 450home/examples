spec: v0.7

name: ubuntu-web-terminal-freeproxy

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs:
  source: ./Dockerfile
  format: erofs

cmd: [ "/usr/bin/wrapper.sh" ]

port_map:
  - "443:6080"      # ttyd Web Terminal
  - "8443:39527"    # free-proxy Admin Panel
  - "9527:9527"     # free-proxy Proxy (TCP plain)
