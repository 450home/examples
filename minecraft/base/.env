export EULA="TRUE"
export ENABLE_COMMAND_BLOCK="true"
export ENABLE_RCON="true"
export DUMP_SERVER_PROPERTIES="true"
export JAVA_HOME="/opt/java/openjdk"
export JAVA_VERSION="jdk-25.0.2+10"
export LANG="en_US.UTF-8"
export LANGUAGE="en_US:en"
export LC_ALL="en_US.UTF-8"
export MEMORY="3G"
export MOTD="Welcome to Unikraft Minecraft Server!"
export SNOOPER_ENABLED="false"
export ONLINE_MODE="true"
export OP_PERMISSION_LEVEL="4"
export PATH="/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export TYPE="VANILLA"
export VERSION="26.1"
export VIEW_DISTANCE="14"
# export WHITELIST="<username>" # ONLY USE WITH ONLINE MODE ENABLED
export UID="0"
export GID="0"

# CUSTOM CONFIGURATION
export PUBKEY="<your-ssh-public-key>"
#export TEMPLATE_WITH_WORLD="true"
